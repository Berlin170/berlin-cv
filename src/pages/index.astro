---
import Layout from "../layouts/Layout.astro";
import Desktop from "../components/Desktop.astro";
import Taskbar from "../components/Taskbar.astro";
import MobileView from "../components/MobileView.astro";
import AboutWindow from "../components/windows/AboutWindow.astro";
import ServicesWindow from "../components/windows/ServicesWindow.astro";
import ExperienceWindow from "../components/windows/ExperienceWindow.astro";
import ProjectsWindow from "../components/windows/ProjectsWindow.astro";
import SkillsWindow from "../components/windows/SkillsWindow.astro";
import ContactWindow from "../components/windows/ContactWindow.astro";
import RecycleWindow from "../components/windows/RecycleWindow.astro";
import MinesweeperWindow from "../components/windows/MinesweeperWindow.astro";
import ImageViewerWindow from "../components/windows/ImageViewerWindow.astro";
---

<Layout title="Berlin — Web3 Community Operations & Moderation Specialist">

  <!-- Boot Screen -->
  <div id="boot-screen" style="display:none; position:fixed; inset:0; background:#000; z-index:9999; flex-direction:column; align-items:center; justify-content:center; font-family:'Courier New',monospace; color:#aaa;">
    <div style="width:420px; max-width:90vw;">
      <div style="color:#fff; font-size:20px; font-weight:bold; margin-bottom:6px;">Berlin Portfolio OS v1.0</div>
      <div style="font-size:13px; margin-bottom:4px;">Copyright (C) 2024 Berlin. All rights reserved.</div>
      <div style="font-size:13px; margin-bottom:20px;">Web3 Community Operations & Moderation Specialist</div>
      <div style="background:#111; border:1px solid #333; height:20px; width:100%; margin-bottom:12px;">
        <div id="boot-bar-fill" style="background:#000080; height:100%; width:0%; transition:width 0.5s ease;"></div>
      </div>
      <div id="boot-status" style="font-size:12px; color:#888;">Initializing Berlin Portfolio OS...</div>
    </div>
  </div>

  <Desktop />

  <AboutWindow />
 <ServicesWindow />
  <ExperienceWindow />
  <ProjectsWindow />
  <SkillsWindow />
  <ContactWindow />
  <RecycleWindow />
  <MinesweeperWindow />
  <ImageViewerWindow />

  <Taskbar />

  <MobileView />

  <script>
    import { initWindows, openWindow, initBootScreen } from "../scripts/window-manager.js";
    import { initTaskbar } from "../scripts/taskbar.js";
    import { initMinesweeper } from "../scripts/minesweeper.js";
    import { initSound } from "../scripts/sound.js";

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    if (!isMobile) {
      initBootScreen();
      initWindows();
      initTaskbar();
      initMinesweeper();
      initSound();

      requestAnimationFrame(() => openWindow("about"));

      document.querySelectorAll(".proj-screenshot img").forEach(img => {
        img.addEventListener("click", (e) => {
          e.stopPropagation();
          const src = (img as HTMLImageElement).src;
          const alt = (img as HTMLImageElement).alt || "Image";
          const viewerImg = document.getElementById("viewer-img") as HTMLImageElement;
          const viewerName = document.getElementById("viewer-filename");
          if (viewerImg) viewerImg.src = src;
          if (viewerName) viewerName.textContent = alt;
          if (viewerImg) viewerImg.style.width = "";
          openWindow("viewer");
        });
      });

      const canvas = document.getElementById("viewer-canvas");
      const vimg = document.getElementById("viewer-img") as HTMLImageElement | null;
      let zoom = 1;
      const applyZoom = () => {
        if (!vimg) return;
        canvas?.classList.remove("fit");
        vimg.style.width = (vimg.naturalWidth * zoom) + "px";
        vimg.style.maxWidth = "none";
        vimg.style.height = "auto";
      };
      document.getElementById("viewer-zoom-in")?.addEventListener("click", () => { zoom = Math.min(4, zoom + 0.25); applyZoom(); });
      document.getElementById("viewer-zoom-out")?.addEventListener("click", () => { zoom = Math.max(0.25, zoom - 0.25); applyZoom(); });
      document.getElementById("viewer-fit")?.addEventListener("click", () => {
        zoom = 1;
        if (vimg) { vimg.style.width = ""; vimg.style.maxWidth = "100%"; }
        canvas?.classList.add("fit");
      });

      if (canvas) {
        let panning = false, startX = 0, startY = 0, scroll0X = 0, scroll0Y = 0;
        const onDown = (e: MouseEvent) => {
          panning = true;
          startX = e.clientX; startY = e.clientY;
          scroll0X = canvas.scrollLeft; scroll0Y = canvas.scrollTop;
          canvas.classList.add("panning");
          e.preventDefault();
        };
        const onMove = (e: MouseEvent) => {
          if (!panning) return;
          canvas.scrollLeft = scroll0X - (e.clientX - startX);
          canvas.scrollTop = scroll0Y - (e.clientY - startY);
        };
        const onUp = () => {
          panning = false;
          canvas.classList.remove("panning");
        };
        canvas.addEventListener("mousedown", onDown);
        window.addEventListener("mousemove", onMove);
        window.addEventListener("mouseup", onUp);
        canvas.addEventListener("mouseleave", onUp);

        canvas.addEventListener("touchstart", (e: TouchEvent) => {
          if (!e.touches[0]) return;
          panning = true;
          startX = e.touches[0].clientX; startY = e.touches[0].clientY;
          scroll0X = canvas.scrollLeft; scroll0Y = canvas.scrollTop;
        }, { passive: true });
        canvas.addEventListener("touchmove", (e: TouchEvent) => {
          if (!panning || !e.touches[0]) return;
          canvas.scrollLeft = scroll0X - (e.touches[0].clientX - startX);
          canvas.scrollTop = scroll0Y - (e.touches[0].clientY - startY);
          e.preventDefault();
        }, { passive: false });
        canvas.addEventListener("touchend", onUp);
      }

      document.querySelectorAll(".exp-row").forEach(row => {
        row.addEventListener("click", () => {
          const i = row.getAttribute("data-row");
          const detail = document.querySelector(`.exp-detail[data-detail="${i}"]`);
          if (!detail) return;
          document.querySelectorAll(".exp-row").forEach(r => r.classList.remove("selected"));
          document.querySelectorAll(".exp-detail").forEach(d => d !== detail && d.classList.remove("open"));
          row.classList.add("selected");
          detail.classList.toggle("open");
        });
      });

      const animateSkillBars = () => {
        document.querySelectorAll(".skill-bar-fill").forEach(el => {
          const pct = parseInt(el.getAttribute("data-pct") || "0", 10);
          requestAnimationFrame(() => { (el as HTMLElement).style.width = pct + "%"; });
        });
      };

      document.addEventListener("win:open", (e) => {
        if ((e as CustomEvent).detail.id === "skills") {
          setTimeout(animateSkillBars, 50);
        }
      });
    } else {
      const bars = document.querySelectorAll(".m-skill-row .bar > span");
      bars.forEach(b => {
        const final = (b as HTMLElement).style.width;
        (b as HTMLElement).style.width = "0";
        setTimeout(() => { (b as HTMLElement).style.transition = "width 1.2s steps(24)"; (b as HTMLElement).style.width = final; }, 200);
      });
    }
  </script>
</Layout>
