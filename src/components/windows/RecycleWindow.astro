---
import WindowFrame from "./WindowFrame.astro";
---

<WindowFrame id="recycle" title="Recycle Bin" label="Recycle Bin" icon="/assets/icons/recycle.svg">
  <div style="width: 320px; padding: 12px; text-align: center; background: #fff; border: 2px inset #808080;">
    <div style="font-size: 32px; margin-bottom: 8px;">🗑️</div>
    <p style="margin: 0 0 6px; font-weight: bold;">The Recycle Bin is empty.</p>
    <p style="margin: 0; font-size: 10px; color: #555;">No regrets. No abandoned drafts.<br/>Only the work that shipped.</p>
  </div>
</WindowFrame>
