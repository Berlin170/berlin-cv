---
const { title = "Berlin — Web3 Community Moderator" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Berlin — Web3 Community Operations & Moderation Specialist. Supporting Telegram and Discord communities across 8+ Web3 projects." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Available for Web3 moderation and community operations." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://berlinportfolio.com/og-image.png" />
    <meta property="og:url" content="https://berlinportfolio.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://berlinportfolio.com/og-image.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://unpkg.com/98.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  @import "../styles/main.css";
  @import "../styles/windows.css";
</style>
